# Root Lombok config for the project.
config.stopBubbling = true

# Copy Spring's @Lazy from a field onto the constructor parameter that
# @RequiredArgsConstructor generates. Without this, @Lazy on a field is ignored
# for constructor injection -- Spring never sees it -- and the deliberately
# @Lazy-broken circular dependency between UserAccessService and
# MakerCheckerService becomes a hard cycle that fails context startup.
# (Also copies @Qualifier/@Value, the usual companions, so future uses work too.)
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
